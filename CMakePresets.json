{
  "version": 2,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "PC common logic (no hardware)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [{ "name": "host", "configurePreset": "host" }],
  "testPresets": [
    { "name": "host", "configurePreset": "host", "output": { "outputOnFailure": true } }
  ]
}
